# Suricata. Inspects the parsed server certificate issuer when visible.
# The issuer name is a triage signal. The root may be absent from the chain, and TLS 1.3 encrypts certificate messages.
alert tls any any -> any any (msg:"LOCAL TLS server certificate issuer mentions emSign ECC Root CA - G3"; flow:established,to_client; tls.cert_issuer; content:"emSign ECC Root CA - G3"; sid:1000133; rev:1;)
