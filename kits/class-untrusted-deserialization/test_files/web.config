<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <httpRuntime targetFramework="4.8" />
    <compilation debug="true" targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="2880" />
    </authentication>
    <!-- This is a test configuration file with unsafe deserialization settings -->
    <customErrors mode="Off" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.Serialization.Formatters.Binary" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <codeBase version="4.0.0.0" href="bin\System.Runtime.Serialization.Formatters.Binary.dll" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>